# Normalize text files to LF in the repository so Linux/macOS checkouts work
# regardless of the contributor's core.autocrlf setting.
* text=auto eol=lf

# Windows-only scripts must keep CRLF for cmd.exe / Windows PowerShell.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.ico binary
*.png binary
*.jpg binary
*.gif binary
